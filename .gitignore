__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Configuração de editor: o settings.json aponta o interpretador com caminho de
# Windows (.venv\Scripts\), então não serve para quem clona em Linux ou macOS.
.vscode/

# Instruções locais para agentes de código: convenção de quem mexe no projeto,
# não parte dele. Nada aqui dentro é necessário para clonar, rodar ou entender o
# solver — isso está no README.
CLAUDE.md

# Dados derivados — todos se regeneram sozinhos na primeira execução.
# As fontes vêm de github.com/fserb/pt-br; a matriz leva ~4 s para reconstruir.
data/icf.txt
data/lexico.txt
data/matriz_padroes.npy
data/matriz_padroes.json

# data/aberturas.json FICA versionado: é a conta mais cara do uso diário
# (partições do léxico inteiro contra si mesmo) e não muda a não ser que o
# léxico ou o ICF mudem — não faz sentido recalcular a cada checkout.
#
# data/aberturas_nivel3.json, idem, e com muito mais razão: a abertura do nível 3
# é uma busca na árvore de decisão a partir das 6.046 candidatas e leva dezenas de
# minutos. Sem ela versionada, `--nivel 3` seria inutilizável na primeira partida.

# O léxico final (termo_lexico_5letras.txt) e os PNGs/JSONs de resultados/ FICAM
# versionados: são o que o README referencia e o que se quer comparar entre
# execuções. Os logs de execução, não — são ruído e carregam o caminho absoluto
# da máquina que rodou o benchmark.
resultados/log_*.txt
